# ==============================================================================
# .gitignore - Android Malware Scanner (Skripsi)
# Keamanan: Mencegah file sensitif, environment, cache, dan sampel APK terunggah
# ==============================================================================

# 1. Virtual Environments (JANGAN DI-PUSH: Ukuran besar & spesifik OS)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 2. Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Environment Variables & Secrets / Credentials (SANGAT KRUSIAL!)
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml
*.pem
*.key
*.pfx
*.p12

# 4. Android APK & Malware Binaries (KEAMANAN & KEBIJAKAN GITHUB)
# GitHub melarang penyebaran malware aktif dan file APK berukuran besar.
*.apk
*.apks
*.xapk
*.aab
*.dex
*.jar
temp_apk/
temp_extracted/
uploads/
samples/
malware/
benign/
datasets/raw/
*.zip
*.tar.gz
*.rar
*.7z

# 5. Testing & Code Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
nosetests.xml
coverage.xml

# 6. IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# 7. Operating System Cache
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# 8. Logs
*.log
logs/
